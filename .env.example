# ==============================================================================
# AVATAROS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local configuration: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED FOR LOCAL DEVELOPMENT
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory path where generated media assets and C2PA manifests are stored
VAULT_STORAGE_PATH=backend/static/media

# Path to ffmpeg binary (leave blank for automatic PATH discovery)
FFMPEG_PATH=

# ------------------------------------------------------------------------------
# 2. REQUIRED FOR CLICKHOUSE (Milestone 2 Analytics & Feedback Loop)
# ------------------------------------------------------------------------------
# Active provider: 'clickhouse' (default, falls back to in-memory on failure) or 'in_memory'
TELEMETRY_PROVIDER=clickhouse
# HTTP interface endpoint for ClickHouse instance
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_BATCH_SIZE=50
CLICKHOUSE_FLUSH_INTERVAL_SEC=2.0
CLICKHOUSE_CONNECT_TIMEOUT=2.0
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 3. KNOWLEDGE BASE & HYBRID RETRIEVAL (Milestone 3 Grounded Knowledge Engine)
# ------------------------------------------------------------------------------
# Embedding provider: 'deterministic' (offline development/testing) or 'gemini' (cloud production)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=256
VECTOR_STORE_PROVIDER=in_memory
VECTOR_WEIGHT=0.65
LEXICAL_WEIGHT=0.35
HYBRID_TOP_K=5
KNOWLEDGE_BASE_PATH=backend/knowledge
CLAIM_CONFIDENCE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# 4. REQUIRED FOR REAL GEMINI / GOOGLE ADK (Milestone 4 Agent Reasoning)
# ------------------------------------------------------------------------------
# AI Provider: 'deterministic' (local test engine) or 'gemini' (Google GenAI / Vertex AI)
AI_PROVIDER=deterministic
# Your Gemini API Key from Google AI Studio (leave empty to use local deterministic rule engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GOOGLE_GENAI_USE_VERTEXAI=false
ADK_ENABLED=true

# ------------------------------------------------------------------------------
# 5. MULTIMODAL GUARDIAN & ASR (Milestone 5 Rendered-Media Verification)
# ------------------------------------------------------------------------------
# Multimodal Guardian Provider: 'deterministic' or 'gemini_multimodal'
GUARDIAN_PROVIDER=deterministic
# ASR Provider: 'deterministic', 'google', or 'gemini'
ASR_PROVIDER=deterministic
ASR_LANGUAGE=en
GUARDIAN_FRAME_SAMPLE_COUNT=5
GUARDIAN_IDENTITY_THRESHOLD=0.92
GUARDIAN_VOICE_THRESHOLD=0.90
GUARDIAN_SCRIPT_ADHERENCE_THRESHOLD=95.0
GUARDIAN_EMOTION_MISMATCH_THRESHOLD=0.30
GUARDIAN_MAX_VIDEO_DURATION=300.0
GUARDIAN_MAX_FILE_SIZE_BYTES=524288000
FFPROBE_PATH=


# ------------------------------------------------------------------------------
# 4. REQUIRED FOR GOOGLE CLOUD (Phase 1/2 Production Deployments)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. REQUIRED FOR REAL AVATAR RENDERING (Milestone 7 Neural Video Engine)
# ------------------------------------------------------------------------------
# Supported providers: ffmpeg, neural_liveportrait, external_api
RENDERER_PROVIDER=ffmpeg
RENDERER_API_KEY=

# ------------------------------------------------------------------------------
# 6. REQUIRED FOR LIVE MODE (Milestone 6 Gemini Live Realtime Streaming)
# ------------------------------------------------------------------------------
# Live Provider: 'deterministic' (offline rule engine), 'gemini_live' (Google GenAI Live API), or 'mistral' (turn-based fallback)
LIVE_PROVIDER=deterministic
LIVE_MODEL=gemini-2.5-flash
LIVE_LANGUAGE=en
LIVE_VOICE=Aoede
LIVE_AUDIO_SAMPLE_RATE=16000
LIVE_MAX_SESSION_DURATION=1800.0
LIVE_RESPONSE_TIMEOUT=10.0
LIVE_ENABLE_AUDIO_INPUT=true
LIVE_ENABLE_AUDIO_OUTPUT=true
LIVE_MODE_ENABLED=true

# ------------------------------------------------------------------------------
# 7. MISTRAL AI CONVERSATIONAL & FALLBACK (Milestone 6)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT=15.0
MISTRAL_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 8. MCP + CLICKHOUSE PARTNER INTEGRATION (Milestone 7 Agent Tool Governance)
# ------------------------------------------------------------------------------
# MCP Provider: 'deterministic' (offline test adapter) or 'clickhouse_mcp' (official partner)
MCP_ENABLED=true
MCP_PROVIDER=deterministic
MCP_SERVER_URL=http://localhost:8123
MCP_TRANSPORT=in_process
MCP_TIMEOUT=5.0
MCP_MAX_TOOL_CALLS=10
MCP_ENVIRONMENT=development
